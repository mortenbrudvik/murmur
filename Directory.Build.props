<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- The oldest Windows Murmur supports: Windows 11 24H2. It equals the MSIX manifest's MinVersion. Stated rather than
         left to default from the TargetFramework, so raising the SDK above does not silently raise the minimum OS. -->
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- version.json is the one source of the version: build-msix.ps1 reads it for the package, and every assembly
         carries it for the About window and the splash (AppInfo). No commit suffix, so what is shown is what is in the file. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)version.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The .editorconfig naming and namespace rules are checked by the build, not only shown in the editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- The year of the build, for the About window's copyright line (AppInfo.BuildYear). -->
    <AssemblyMetadata Include="BuildYear" Value="$([System.DateTime]::Now.Year)" />
  </ItemGroup>
</Project>
