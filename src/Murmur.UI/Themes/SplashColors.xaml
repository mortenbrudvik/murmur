<!-- The splash's colours: the shared palette (Palette.xaml), and the card's own background. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#14161D" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashBorderBrush" Color="{StaticResource PaletteBorderColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashStrongTextBrush" Color="{StaticResource PaletteStrongTextColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashMutedBrush" Color="{StaticResource PaletteMutedColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashDimBrush" Color="{StaticResource PaletteDimColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashAccentBrush" Color="{StaticResource PaletteAccentColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashOkBrush" Color="{StaticResource PaletteOkColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="SplashErrorBrush" Color="{StaticResource PaletteErrorColor}" po:Freeze="True" />
  <Color x:Key="SplashShadowColor">#FF000000</Color>
</ResourceDictionary>
