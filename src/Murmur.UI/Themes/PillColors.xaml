<!-- The recording pill's colours. PillTextBrush and PillAccentBrush come from the shared palette (Palette.xaml); the rest
     belong to the pill alone. With a Windows contrast theme on, PillContrast overrides every key with system colours. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="PillBackgroundBrush" Color="#E0161820" po:Freeze="True" />
  <SolidColorBrush x:Key="PillBorderBrush" Color="#1FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="PillRecordingBrush" Color="#FF5A5F" po:Freeze="True" />
  <SolidColorBrush x:Key="PillRecordingHaloBrush" Color="#2EFF5A5F" po:Freeze="True" />
  <SolidColorBrush x:Key="PillAccentBrush" Color="{StaticResource PaletteAccentColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="PillTextBrush" Color="{StaticResource PaletteTextColor}" po:Freeze="True" />
  <Color x:Key="PillShadowColor">#FF000000</Color>
</ResourceDictionary>
