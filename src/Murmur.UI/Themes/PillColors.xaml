<!-- The recording pill's colours. PillTextBrush and PillAccentBrush copy the text and accent variables of the web app's palette
     in src/WebApp/src/index.css, which is their source: change them there, then here. The rest belong to the pill
     alone. With a Windows contrast theme on, PillContrast overrides every key with system colours. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <SolidColorBrush x:Key="PillBackgroundBrush" Color="#E0161820" po:Freeze="True" />
  <SolidColorBrush x:Key="PillBorderBrush" Color="#1FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="PillRecordingBrush" Color="#FF5A5F" po:Freeze="True" />
  <SolidColorBrush x:Key="PillRecordingHaloBrush" Color="#2EFF5A5F" po:Freeze="True" />
  <SolidColorBrush x:Key="PillAccentBrush" Color="#8FB3FF" po:Freeze="True" />
  <SolidColorBrush x:Key="PillTextBrush" Color="#DFE3EE" po:Freeze="True" />
  <Color x:Key="PillShadowColor">#FF000000</Color>
</ResourceDictionary>
