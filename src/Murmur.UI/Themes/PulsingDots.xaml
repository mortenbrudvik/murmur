<!-- Three dots that pulse in turn (1 s cycle, 0.15 s apart) for as long as they are visible: something is on its way.
     The pill and the splash merge this into their own resources, so the windows also load without the app's. The dots
     take the control's Foreground. Its Tag says whether Windows' animation effects are on (bind it to
     SystemParameters.ClientAreaAnimationKey; Settings > Accessibility > Visual effects); with them off, or with no Tag,
     the dots stand still, half lit. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    mc:Ignorable="po">
  <SineEase x:Key="PulseEasing" EasingMode="EaseInOut" po:Freeze="True" />

  <ControlTemplate x:Key="PulsingDotsTemplate" TargetType="Control">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Ellipse x:Name="Dot1" Width="4" Height="4" Opacity="0.6" Fill="{TemplateBinding Foreground}" />
      <Ellipse x:Name="Dot2" Width="4" Height="4" Opacity="0.6" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
      <Ellipse x:Name="Dot3" Width="4" Height="4" Opacity="0.6" Margin="3,0,0,0" Fill="{TemplateBinding Foreground}" />
    </StackPanel>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsVisible" Value="True" />
          <Condition Property="Tag">
            <Condition.Value>
              <sys:Boolean>True</sys:Boolean>
            </Condition.Value>
          </Condition>
        </MultiTrigger.Conditions>
        <Setter TargetName="Dot1" Property="Opacity" Value="0.25" />
        <Setter TargetName="Dot2" Property="Opacity" Value="0.25" />
        <Setter TargetName="Dot3" Property="Opacity" Value="0.25" />
        <MultiTrigger.EnterActions>
          <BeginStoryboard Name="Pulse">
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                               From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"
                               EasingFunction="{StaticResource PulseEasing}" />
              <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                               From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.15" AutoReverse="True" RepeatBehavior="Forever"
                               EasingFunction="{StaticResource PulseEasing}" />
              <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                               From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"
                               EasingFunction="{StaticResource PulseEasing}" />
            </Storyboard>
          </BeginStoryboard>
        </MultiTrigger.EnterActions>
        <MultiTrigger.ExitActions>
          <RemoveStoryboard BeginStoryboardName="Pulse" />
        </MultiTrigger.ExitActions>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>
