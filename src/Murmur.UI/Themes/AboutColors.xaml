<!-- The About window's colours: text, muted, dim, accent, error and the border come from the shared palette
     (Palette.xaml); the rest belong to the About window alone. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Palette.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="AboutBackgroundBrush" Color="#1E212A" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutFootBrush" Color="#191B23" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutBorderBrush" Color="{StaticResource PaletteBorderColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutFaintBorderBrush" Color="#0DFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutTextBrush" Color="{StaticResource PaletteTextColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutStrongTextBrush" Color="{StaticResource PaletteStrongTextColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutMutedBrush" Color="{StaticResource PaletteMutedColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutDimBrush" Color="{StaticResource PaletteDimColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutAccentBrush" Color="{StaticResource PaletteAccentColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutAccentHoverBrush" Color="#A6C2FF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutOnAccentBrush" Color="#10131C" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutErrorBrush" Color="{StaticResource PaletteErrorColor}" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutButtonBrush" Color="#0FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutButtonHoverBrush" Color="#1AFFFFFF" po:Freeze="True" />
  <Color x:Key="AboutShadowColor">#FF000000</Color>
</ResourceDictionary>
