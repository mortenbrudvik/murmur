<!-- The About window's colours. They copy the web app's palette in src/WebApp/src/index.css (text, muted, dim, accent,
     error and the two borders), which is their source: change them there, then here. The rest belong to the About
     window alone. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
  <SolidColorBrush x:Key="AboutBackgroundBrush" Color="#1E212A" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutFootBrush" Color="#191B23" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutBorderBrush" Color="#1AFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutFaintBorderBrush" Color="#0DFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutTextBrush" Color="#DFE3EE" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutStrongTextBrush" Color="#E9ECF5" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutMutedBrush" Color="#9AA3B8" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutDimBrush" Color="#7D859B" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutAccentBrush" Color="#8FB3FF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutAccentHoverBrush" Color="#A6C2FF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutOnAccentBrush" Color="#10131C" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutErrorBrush" Color="#FF6B6B" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutButtonBrush" Color="#0FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="AboutButtonHoverBrush" Color="#1AFFFFFF" po:Freeze="True" />
  <Color x:Key="AboutShadowColor">#FF000000</Color>
</ResourceDictionary>
