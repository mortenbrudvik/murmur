<ui:FluentWindow x:Class="Murmur.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Murmur" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Murmur" />

    <!-- Collapsed when WebView2 failed: its window would otherwise be drawn over the failure panel. -->
    <ContentPresenter Grid.Row="1" Content="{Binding WebView}">
      <ContentPresenter.Style>
        <Style TargetType="ContentPresenter">
          <Style.Triggers>
            <DataTrigger Binding="{Binding WebViewFailed}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentPresenter.Style>
    </ContentPresenter>

    <!-- Shown instead of the web UI when WebView2 could not start or failed for good. -->
    <StackPanel Grid.Row="1" MaxWidth="520" Margin="32" VerticalAlignment="Center">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding WebViewFailed}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <TextBlock Text="Murmur's window couldn't load"
                 FontSize="20"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="Dictation still works: hold the hotkey as usual. Restarting Murmur usually brings the window back. If it doesn't, the log explains what went wrong." />
      <TextBlock Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}">
        <Run Text="The log is in " /><Run Text="{Binding LogsDirectory, Mode=OneWay}" /><Run Text="." />
      </TextBlock>

      <WrapPanel Margin="0,20,0,0">
        <ui:Button Content="Restart Murmur" Appearance="Primary" Command="{Binding RestartCommand}" Margin="0,0,8,8" />
        <ui:Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,8" />
        <ui:Button Content="Quit Murmur" Command="{Binding QuitCommand}" Margin="0,0,8,8" />
      </WrapPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
