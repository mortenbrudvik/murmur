<Window x:Class="Murmur.UI.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pill="clr-namespace:Murmur.UI.Pill"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="po"
        Title="Murmur recording indicator"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI">

  <!-- The colours (PillBackgroundBrush and the rest) are app resources, in Themes/PillColors.xaml. -->
  <Window.Resources>
    <pill:BarHeightConverter x:Key="BarHeightConverter" />
    <SineEase x:Key="PulseEasing" EasingMode="EaseInOut" po:Freeze="True" />

    <!-- The faces of the pill are all collapsed until the view model's Mode selects one. -->
    <Style x:Key="ModeSection" TargetType="FrameworkElement">
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- A part of the recording face that only shows once the microphone is live. -->
    <Style x:Key="ListeningOnly" TargetType="FrameworkElement" BasedOn="{StaticResource ModeSection}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Mode}" Value="Listening">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A part of the recording face that only shows while the microphone is being started. -->
    <Style x:Key="StartingOnly" TargetType="FrameworkElement" BasedOn="{StaticResource ModeSection}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Mode}" Value="Starting">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Three dots that pulse in turn (1 s cycle, 0.15 s apart) for as long as they are visible. The control's Tag says
         whether Windows' animation effects are on (Settings > Accessibility > Visual effects); with them off the dots
         stand still, half lit. -->
    <ControlTemplate x:Key="PulsingDotsTemplate" TargetType="Control">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="4" Height="4" Opacity="0.25" Fill="{DynamicResource PillAccentBrush}" />
        <Ellipse x:Name="Dot2" Width="4" Height="4" Opacity="0.25" Margin="3,0,0,0" Fill="{DynamicResource PillAccentBrush}" />
        <Ellipse x:Name="Dot3" Width="4" Height="4" Opacity="0.25" Margin="3,0,0,0" Fill="{DynamicResource PillAccentBrush}" />
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="Tag">
          <Trigger.Value>
            <sys:Boolean>False</sys:Boolean>
          </Trigger.Value>
          <Setter TargetName="Dot1" Property="Opacity" Value="0.6" />
          <Setter TargetName="Dot2" Property="Opacity" Value="0.6" />
          <Setter TargetName="Dot3" Property="Opacity" Value="0.6" />
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsVisible" Value="True" />
            <Condition Property="Tag">
              <Condition.Value>
                <sys:Boolean>True</sys:Boolean>
              </Condition.Value>
            </Condition>
          </MultiTrigger.Conditions>
          <MultiTrigger.EnterActions>
            <BeginStoryboard Name="Pulse">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.15" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
              </Storyboard>
            </BeginStoryboard>
          </MultiTrigger.EnterActions>
          <MultiTrigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="Pulse" />
          </MultiTrigger.ExitActions>
        </MultiTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Window.Resources>

  <!-- The margin is transparent window area that the drop shadow is drawn into. The capsule is 30 DIPs high in every
       mode, so CornerRadius 15 makes true semicircular ends (WPF scales a huge radius per axis into an ellipse).
       Layout rounding puts the bars' edges on whole pixels, so they are not anti-aliased differently from frame to frame. -->
  <Border x:Name="Capsule"
          UseLayoutRounding="True"
          Margin="{x:Static pill:PillWindow.ShadowMargin}"
          Padding="12,6"
          CornerRadius="15"
          BorderThickness="1"
          BorderBrush="{DynamicResource PillBorderBrush}"
          Background="{DynamicResource PillBackgroundBrush}"
          IsHitTestVisible="False">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="{DynamicResource PillShadowColor}" />
    </Border.Effect>

    <!-- MinHeight keeps the capsule the same height in every mode, so it only changes width. -->
    <Grid MinHeight="{x:Static pill:BarHeightConverter.MaxHeight}">

      <!-- The recording face, the same size in both of its modes so the pill does not move between them.
           Starting: a hollow dot and dimmed, flat bars, because nothing is recorded until the microphone delivers.
           Listening: the red dot and the level bars. -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel" BasedOn="{StaticResource ModeSection}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Mode}" Value="Starting">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Mode}" Value="Listening">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>

        <Grid Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
          <Ellipse x:Name="StartingDot"
                   StrokeThickness="1.5"
                   Opacity="0.55"
                   Stroke="{DynamicResource PillTextBrush}"
                   Style="{StaticResource StartingOnly}" />
          <Grid x:Name="RecordingDot" Style="{StaticResource ListeningOnly}">
            <Ellipse Margin="-3" Fill="{DynamicResource PillRecordingHaloBrush}" />
            <Ellipse Fill="{DynamicResource PillRecordingBrush}" />
          </Grid>
        </Grid>

        <!-- 2 px between bars: 1 px either side of each, pulled back in at the ends. -->
        <ItemsControl ItemsSource="{Binding Bars}"
                      Height="{x:Static pill:BarHeightConverter.MaxHeight}"
                      Margin="-1,0"
                      Focusable="False"
                      IsTabStop="False">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Starting">
                  <Setter Property="Opacity" Value="0.35" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Rectangle Width="2.5"
                         Margin="1,0"
                         RadiusX="1.25"
                         RadiusY="1.25"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource PillAccentBrush}"
                         Height="{Binding Converter={StaticResource BarHeightConverter}}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Transcribing: three pulsing dots -->
      <Control x:Name="TranscribingDots"
               Template="{StaticResource PulsingDotsTemplate}"
               Tag="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
               Focusable="False"
               IsTabStop="False">
        <Control.Style>
          <Style TargetType="Control" BasedOn="{StaticResource ModeSection}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Mode}" Value="Transcribing">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Control.Style>
      </Control>

      <!-- Notice: a short message. A live region, and PillWindow.Announce raises a notification for screen readers. -->
      <TextBlock x:Name="NoticeTextBlock"
                 Text="{Binding NoticeText}"
                 AutomationProperties.LiveSetting="Assertive"
                 FontSize="12"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap"
                 Foreground="{DynamicResource PillTextBrush}">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource ModeSection}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Mode}" Value="Notice">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

    </Grid>
  </Border>
</Window>
