<Window x:Class="Murmur.UI.Splash.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:speech="clr-namespace:Murmur.Core.Speech;assembly=Murmur.Core"
        xmlns:splash="clr-namespace:Murmur.UI.Splash"
        Title="Murmur"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <!-- The colours (SplashBackgroundBrush and the rest) are app resources, in Themes/SplashColors.xaml. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Murmur.UI;component/Themes/PulsingDots.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <splash:StatusOpacityConverter x:Key="StatusOpacity" />
    </ResourceDictionary>
  </Window.Resources>

  <!-- The margin is transparent window area that the drop shadow is drawn into. -->
  <Border x:Name="Card"
          Margin="28"
          Width="460"
          Height="280"
          CornerRadius="12"
          BorderThickness="1"
          BorderBrush="{DynamicResource SplashBorderBrush}"
          Background="{DynamicResource SplashBackgroundBrush}"
          UseLayoutRounding="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.55" Color="{DynamicResource SplashShadowColor}" />
    </Border.Effect>

    <!-- -1 all round: the canvas is laid out in the card's full 460 by 280, under its 1 px border. -->
    <Grid Margin="-1">
      <!-- One clock for the whole splash: the canvas draws the moment it is given, and SplashWindow.Play runs the
           clock. Time starts at 0: until Play, the splash shows its first frame, the line at rest. -->
      <splash:SplashCanvas x:Name="Canvas"
                           Time="0"
                           NameBrush="{DynamicResource SplashStrongTextBrush}"
                           CaretBrush="{DynamicResource SplashAccentBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />

      <!-- The speech engine's status, in the main window's wording; there from early on. -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="24,222,24,0"
                  Opacity="{Binding Time, ElementName=Canvas, Converter={StaticResource StatusOpacity}}">
        <Control x:Name="BusyDots"
                 Template="{StaticResource PulsingDotsTemplate}"
                 Foreground="{DynamicResource SplashAccentBrush}"
                 Tag="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}"
                 Focusable="False"
                 IsTabStop="False"
                 Margin="0,1,8,0">
          <Control.Style>
            <Style TargetType="Control">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Ready}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Error}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Control.Style>
        </Control>

        <Ellipse Width="6" Height="6" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource SplashOkBrush}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Ready}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="12.5"
                   MaxWidth="380"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource SplashMutedBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Error}">
                  <Setter Property="Foreground" Value="{DynamicResource SplashErrorBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <TextBlock Text="{Binding Version}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,15,10"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="11"
                 Foreground="{DynamicResource SplashDimBrush}"
                 Opacity="{Binding Time, ElementName=Canvas, Converter={StaticResource StatusOpacity}}" />
    </Grid>
  </Border>
</Window>
