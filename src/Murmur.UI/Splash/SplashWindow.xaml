<Window x:Class="Murmur.UI.Splash.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:speech="clr-namespace:Murmur.Core.Speech;assembly=Murmur.Core"
        xmlns:splash="clr-namespace:Murmur.UI.Splash"
        mc:Ignorable="po"
        Title="Murmur"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#14161D" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashBorderBrush" Color="#1AFFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashMutedBrush" Color="#9AA3B8" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashDimBrush" Color="#7D859B" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashAccentBrush" Color="#8FB3FF" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashOkBrush" Color="#3ECF8E" po:Freeze="True" />
    <SolidColorBrush x:Key="SplashErrorBrush" Color="#FF6B6B" po:Freeze="True" />

    <splash:StatusOpacityConverter x:Key="StatusOpacity" />
    <SineEase x:Key="PulseEasing" EasingMode="EaseInOut" po:Freeze="True" />

    <!-- Three dots that pulse in turn, as on the pill: something is on its way. -->
    <ControlTemplate x:Key="PulsingDotsTemplate" TargetType="Control">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Dot1" Width="4" Height="4" Opacity="0.25" Fill="{DynamicResource SplashAccentBrush}" />
        <Ellipse x:Name="Dot2" Width="4" Height="4" Opacity="0.25" Margin="3,0,0,0" Fill="{DynamicResource SplashAccentBrush}" />
        <Ellipse x:Name="Dot3" Width="4" Height="4" Opacity="0.25" Margin="3,0,0,0" Fill="{DynamicResource SplashAccentBrush}" />
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsVisible" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard Name="Pulse">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
                <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.15" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
                <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity"
                                 From="0.25" To="1" Duration="0:0:0.5" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"
                                 EasingFunction="{StaticResource PulseEasing}" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <RemoveStoryboard BeginStoryboardName="Pulse" />
          </Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </Window.Resources>

  <!-- The margin is transparent window area that the drop shadow is drawn into. -->
  <Border x:Name="Card"
          Margin="28"
          Width="460"
          Height="280"
          CornerRadius="12"
          BorderThickness="1"
          BorderBrush="{DynamicResource SplashBorderBrush}"
          Background="{DynamicResource SplashBackgroundBrush}"
          UseLayoutRounding="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black" />
    </Border.Effect>

    <!-- -1 all round: the canvas is laid out in the card's full 460 by 280, under its 1 px border. -->
    <Grid Margin="-1">
      <!-- One clock for the whole splash: the canvas draws the moment it is given, and SplashWindow.Play runs the
           clock. Time starts at 0: until Play, the splash shows its first frame, the line at rest. -->
      <splash:SplashCanvas x:Name="Canvas" Time="0" HorizontalAlignment="Left" VerticalAlignment="Top" />

      <!-- The speech engine's status, in the main window's wording; there from early on. -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Margin="24,222,24,0"
                  Opacity="{Binding Time, ElementName=Canvas, Converter={StaticResource StatusOpacity}}">
        <Control Template="{StaticResource PulsingDotsTemplate}" Focusable="False" IsTabStop="False" Margin="0,1,8,0">
          <Control.Style>
            <Style TargetType="Control">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Ready}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Error}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Control.Style>
        </Control>

        <Ellipse Width="6" Height="6" Margin="0,1,8,0" VerticalAlignment="Center" Fill="{DynamicResource SplashOkBrush}">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Ready}">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>

        <TextBlock Text="{Binding StatusText}"
                   FontSize="12.5"
                   MaxWidth="380"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource SplashMutedBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static speech:EngineStatusTone.Error}">
                  <Setter Property="Foreground" Value="{DynamicResource SplashErrorBrush}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>

      <TextBlock Text="{Binding Version}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,15,10"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="11"
                 Foreground="{DynamicResource SplashDimBrush}"
                 Opacity="{Binding Time, ElementName=Canvas, Converter={StaticResource StatusOpacity}}" />
    </Grid>
  </Border>
</Window>
