<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

  <!-- Name, Publisher and PublisherDisplayName come verbatim from Partner Center's "Product identity" page. They are
       case- and punctuation-sensitive and a mismatch is rejected at upload. Publisher is the account's, shared with
       Loadstone. "Murmur" was taken in the Store, so the reserved name is "Murmur Voice Typing" (reserved
       2026-10-30, Store ID 9N2FVKGMJQ5S); both DisplayNames must equal it, while the tile ShortName and the app's
       own UI keep saying "Murmur".
       Version is kept in step with version.json by hand - there is no version-manager script - and build-msix.ps1
       refuses to pack when the two disagree. Its fourth field is reserved for the Store and must stay 0. -->
  <Identity
      Name="MortenBrudvik.MurmurVoiceTyping"
      Publisher="CN=E6ED6F6D-88CB-42AC-BED3-B0FA24EC28DD"
      Version="1.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Murmur Voice Typing</DisplayName>
    <PublisherDisplayName>Morten Brudvik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Nothing Murmur calls is newer than 19041: StartupTask dates from 14393 and
         AppInstance.GetActivatedEventArgs from 17134. MinVersion is a commitment to the Store, not a hint, and
         Windows 10 has never actually been tested. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Murmur" Executable="Murmur.UI.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- A normal list entry and tile on purpose: AppListEntry="none" would leave a tray app with nothing a Store
           reviewer can launch from the Start menu. -->
      <uap:VisualElements
          DisplayName="Murmur Voice Typing"
          Description="Voice typing for Windows: hold a hotkey, talk, and the text lands in the app you are using. Speech recognition runs locally on your PC."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Murmur" />
      </uap:VisualElements>
      <Extensions>
        <!-- Enabled="false": the app must not register itself for sign-in without being asked. The Settings toggle
             turns it on through StartupTask.RequestEnableAsync. TaskId must equal PackagedStartupRegistration.TaskId.
             A startup task cannot pass arguments, so the app recognises a sign-in start from its activation kind
             instead of the Run key's "minimized" switch. -->
        <uap5:Extension Category="windows.startupTask" Executable="Murmur.UI.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="MurmurStartup" Enabled="false" DisplayName="Murmur" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The one network use: the speech model (about 1.6 GB) is downloaded from huggingface.co on first run. A
         full-trust process is not network-isolated, so this gates nothing at run time; it is declared so the
         package says honestly what the app does. -->
    <Capability Name="internetClient" />
    <!-- Mandatory for a packaged Win32 app, and a restricted capability: it needs a written justification at
         submission, which for Murmur must describe its low-level keyboard and mouse hooks plainly (see
         docs/store-submission-runbook.md, "Restricted capability justification"). -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Without it Windows denies a packaged app microphone access, so WASAPI capture fails even though the app is
         full trust. It also lists Murmur under Settings > Privacy & security > Microphone. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
